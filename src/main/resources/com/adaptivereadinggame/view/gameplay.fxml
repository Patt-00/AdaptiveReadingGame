<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import com.adaptivereadinggame.view.StoryArtworkPane?>

<StackPane fx:id="gameplayRoot" styleClass="gameplay-root" prefWidth="1280.0" prefHeight="720.0"
           minWidth="0" minHeight="0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.adaptivereadinggame.controller.GameplayController">
    <StoryArtworkPane fx:id="artworkLayer"/>
    <BorderPane fx:id="gameplayLayout" minWidth="0" minHeight="0">
    <top>
        <HBox fx:id="gameplayHeader" alignment="CENTER_LEFT" spacing="12" styleClass="gameplay-header">
            <VBox spacing="3" minWidth="0" HBox.hgrow="ALWAYS">
                <Label fx:id="chapterTitle" styleClass="gameplay-chapter-title" text="CHAPTER" wrapText="true"/>
                <Label fx:id="difficultyLabel" styleClass="gameplay-difficulty" text="EASY"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="illustrationButton" text="VIEW ILLUSTRATION" minWidth="-Infinity" styleClass="gameplay-menu-button"
                    visible="false" managed="false" onAction="#viewIllustration"/>
            <Button fx:id="storyLogButton" text="STORY LOG" minWidth="-Infinity" accessibleText="Open the story log"
                    styleClass="gameplay-menu-button" visible="false" managed="false" onAction="#openStoryLog"/>
            <Button fx:id="menuButton" text="MENU" minWidth="-Infinity" accessibleText="Open game menu"
                    styleClass="gameplay-menu-button" onAction="#openMenu"/>
        </HBox>
    </top>
    <center>
        <StackPane fx:id="centerRoot" minWidth="0" minHeight="0" styleClass="gameplay-center">
            <ScrollPane fx:id="storyScroll" fitToWidth="true" fitToHeight="true" pannable="true"
                        hbarPolicy="NEVER" minWidth="0" minHeight="0"
                        styleClass="gameplay-scroll" visible="false" managed="false">
              <content>
            <StackPane minWidth="0" minHeight="-Infinity">
            <VBox fx:id="storyPane" minWidth="0" minHeight="-Infinity" spacing="18" alignment="CENTER" maxWidth="1160">
                <StackPane fx:id="storyRow" minWidth="0" maxWidth="1120">
                    <VBox fx:id="portraitColumn" alignment="CENTER" spacing="10" styleClass="portrait-column">
                        <StackPane fx:id="portraitFrame" styleClass="portrait-frame" prefWidth="320" maxWidth="320" prefHeight="460">
                            <Label fx:id="speakerInitials" styleClass="speaker-initials" text=""/>
                            <ImageView fx:id="supportingImage" fitWidth="220" fitHeight="430" preserveRatio="true"
                                       smooth="true" styleClass="speaker-image" visible="false" managed="false"
                                       opacity="0.65" accessibleText="Supporting character artwork"/>
                            <ImageView fx:id="speakerImage" fitWidth="320" fitHeight="460" preserveRatio="true"
                                       smooth="true" styleClass="speaker-image" visible="false" managed="false"
                                       accessibleText="Character artwork"/>
                        </StackPane>
                    </VBox>
                    <VBox fx:id="storyPanel" minWidth="0" minHeight="-Infinity" maxHeight="-Infinity" spacing="14" styleClass="story-panel" maxWidth="800" prefWidth="760">
                        <HBox styleClass="story-panel-heading" alignment="CENTER_LEFT" spacing="12">
                            <Label fx:id="storyModeLabel" styleClass="story-mode" text="NARRATION"/>
                            <Label fx:id="speakerName" styleClass="speaker-name" text="Narration" wrapText="true"
                                   visible="false" managed="false"/>
                            <Region HBox.hgrow="ALWAYS"/>
                        </HBox>
                        <ScrollPane fx:id="dialogueScroll" fitToWidth="true" fitToHeight="false" pannable="true"
                                    prefViewportHeight="220" maxHeight="220" styleClass="story-scroll">
                            <content>
                                <Label fx:id="storyText" minWidth="0" minHeight="-Infinity" styleClass="story-text" wrapText="true" maxWidth="740"/>
                            </content>
                        </ScrollPane>
                    </VBox>
                </StackPane>
                <VBox fx:id="storyChoices" spacing="10" alignment="CENTER" maxWidth="850"/>
            </VBox>
            </StackPane>
              </content>
            </ScrollPane>
            <ScrollPane fx:id="assessmentScroll" fitToWidth="true" fitToHeight="false" pannable="true"
                        hbarPolicy="NEVER" minWidth="0" minHeight="0"
                        styleClass="gameplay-scroll" visible="false" managed="false">
              <content>
            <StackPane minWidth="0" minHeight="-Infinity">
            <VBox fx:id="assessmentPane" minWidth="0" minHeight="-Infinity" spacing="8" maxWidth="1100">
                <VBox spacing="8" styleClass="passage-panel">
                    <Label text="READING PASSAGE" styleClass="passage-heading"/>
                    <ScrollPane fitToWidth="true" prefViewportHeight="105" maxHeight="125" styleClass="passage-scroll">
                        <content>
                            <Label fx:id="passageText" minHeight="-Infinity" styleClass="passage-text" wrapText="true" maxWidth="1020"/>
                        </content>
                    </ScrollPane>
                </VBox>
                <HBox alignment="CENTER_LEFT" spacing="12">
                    <Label fx:id="questionProgress" styleClass="question-progress" text="Question 1 of 1"/>
                    <Region HBox.hgrow="ALWAYS"/>
                </HBox>
                <Label fx:id="questionPrompt" minHeight="-Infinity" styleClass="question-prompt" wrapText="true"/>
                <VBox fx:id="answerChoices" minHeight="-Infinity" spacing="8"/>
                <VBox fx:id="feedbackPane" minHeight="-Infinity" spacing="6" styleClass="feedback-panel" visible="false" managed="false">
                    <Label fx:id="feedbackHeading" styleClass="feedback-heading"/>
                    <Label fx:id="correctAnswerText" minHeight="-Infinity" styleClass="feedback-answer" wrapText="true"/>
                    <Label fx:id="explanationText" minHeight="-Infinity" styleClass="feedback-explanation" wrapText="true"/>
                </VBox>
                <HBox alignment="CENTER_RIGHT" spacing="14">
                    <Button fx:id="submitButton" text="SUBMIT" styleClass="gold-button"
                            disable="true" onAction="#submitAnswer"/>
                    <Button fx:id="nextQuestionButton" text="NEXT QUESTION" styleClass="gold-button"
                            visible="false" managed="false" onAction="#nextQuestion"/>
                </HBox>
            </VBox>
            </StackPane>
              </content>
            </ScrollPane>
        </StackPane>
    </center>
    <bottom>
        <VBox fx:id="gameplayFooter" alignment="CENTER" spacing="4" styleClass="gameplay-footer">
            <Button fx:id="storyNextButton" text="NEXT" styleClass="gold-button" visible="false" managed="false"
                    onAction="#advanceStory"/>
            <Label fx:id="footerText" wrapText="true" minHeight="-Infinity" styleClass="gameplay-footer-text"
                   text="Story choices change the narrative. Reading Check answers determine the score."/>
            <Label fx:id="fontNotice" styleClass="gameplay-font-notice"/>
        </VBox>
    </bottom>
    </BorderPane>
</StackPane>
