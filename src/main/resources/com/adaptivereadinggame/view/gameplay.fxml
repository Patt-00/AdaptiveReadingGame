<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="gameplayRoot" styleClass="gameplay-root" prefWidth="1280.0" prefHeight="720.0"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.adaptivereadinggame.controller.GameplayController">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="20" styleClass="gameplay-header">
            <VBox spacing="3">
                <Label fx:id="chapterTitle" styleClass="gameplay-chapter-title" text="CHAPTER"/>
                <Label fx:id="difficultyLabel" styleClass="gameplay-difficulty" text="EASY"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="menuButton" text="MENU" accessibleText="Open game menu"
                    styleClass="gameplay-menu-button" onAction="#openMenu"/>
        </HBox>
    </top>
    <center>
        <StackPane fx:id="centerRoot" styleClass="gameplay-center">
            <ScrollPane fx:id="storyScroll" fitToWidth="true" fitToHeight="true" pannable="true"
                        styleClass="gameplay-scroll" visible="false" managed="false">
              <content>
            <VBox fx:id="storyPane" spacing="18" alignment="CENTER" maxWidth="1160">
                <HBox spacing="24" alignment="CENTER" maxWidth="1120">
                    <VBox alignment="CENTER" spacing="10" styleClass="portrait-column">
                        <StackPane fx:id="portraitFrame" styleClass="portrait-frame" prefWidth="250" prefHeight="330">
                            <Label fx:id="speakerInitials" styleClass="speaker-initials" text=""/>
                            <ImageView fx:id="speakerImage" fitWidth="250" fitHeight="330" preserveRatio="true"
                                       smooth="true" visible="false" managed="false" accessibleText="Character artwork"/>
                        </StackPane>
                        <Label fx:id="speakerName" styleClass="speaker-name" text="" wrapText="true"/>
                    </VBox>
                    <VBox fx:id="storyPanel" spacing="12" styleClass="story-panel" maxWidth="800" prefWidth="800">
                        <Label fx:id="storyModeLabel" styleClass="story-mode" text="NARRATION"/>
                        <ScrollPane fitToWidth="true" fitToHeight="true" pannable="true" styleClass="story-scroll">
                            <content>
                                <Label fx:id="storyText" styleClass="story-text" wrapText="true" maxWidth="740"/>
                            </content>
                        </ScrollPane>
                    </VBox>
                </HBox>
                <VBox fx:id="storyChoices" spacing="10" alignment="CENTER" maxWidth="850"/>
                <Button fx:id="storyNextButton" text="NEXT" styleClass="gold-button"
                        onAction="#advanceStory"/>
            </VBox>
              </content>
            </ScrollPane>
            <ScrollPane fx:id="assessmentScroll" fitToWidth="true" fitToHeight="true" pannable="true"
                        styleClass="gameplay-scroll" visible="false" managed="false">
              <content>
            <VBox fx:id="assessmentPane" spacing="8" maxWidth="1100">
                <VBox spacing="8" styleClass="passage-panel">
                    <Label text="READING PASSAGE" styleClass="passage-heading"/>
                    <ScrollPane fitToWidth="true" prefViewportHeight="105" maxHeight="125" styleClass="passage-scroll">
                        <content>
                            <Label fx:id="passageText" styleClass="passage-text" wrapText="true" maxWidth="1020"/>
                        </content>
                    </ScrollPane>
                </VBox>
                <HBox alignment="CENTER_LEFT" spacing="12">
                    <Label fx:id="questionProgress" styleClass="question-progress" text="Question 1 of 1"/>
                    <Region HBox.hgrow="ALWAYS"/>
                </HBox>
                <Label fx:id="questionPrompt" styleClass="question-prompt" wrapText="true"/>
                <VBox fx:id="answerChoices" spacing="8"/>
                <VBox fx:id="feedbackPane" spacing="6" styleClass="feedback-panel" visible="false" managed="false">
                    <Label fx:id="feedbackHeading" styleClass="feedback-heading"/>
                    <Label fx:id="correctAnswerText" styleClass="feedback-answer" wrapText="true"/>
                    <Label fx:id="explanationText" styleClass="feedback-explanation" wrapText="true"/>
                </VBox>
                <HBox alignment="CENTER_RIGHT" spacing="14">
                    <Button fx:id="submitButton" text="SUBMIT" styleClass="gold-button"
                            disable="true" onAction="#submitAnswer"/>
                    <Button fx:id="nextQuestionButton" text="NEXT QUESTION" styleClass="gold-button"
                            visible="false" managed="false" onAction="#nextQuestion"/>
                </HBox>
            </VBox>
              </content>
            </ScrollPane>
        </StackPane>
    </center>
    <bottom>
        <VBox alignment="CENTER" spacing="4" styleClass="gameplay-footer">
            <Label fx:id="footerText" styleClass="gameplay-footer-text"
                   text="Story choices change the narrative. Reading Check answers determine the score."/>
            <Label fx:id="fontNotice" styleClass="gameplay-font-notice"/>
        </VBox>
    </bottom>
</BorderPane>
